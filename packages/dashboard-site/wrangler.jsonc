{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tumpel-dashboard",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "dev": { "name": "tumpel-dashboard-dev" },
    "prod": { "name": "tumpel-dashboard-prod" }
  }
}
