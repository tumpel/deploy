{
  "name": "tumpel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "fix": "biome check --write .",
    "check": "npm run lint",
    "prepare": "git config core.hooksPath .githooks",
    "test": "node --test --test-timeout=30000 npm-scripts/*.test.mjs",
    "deploy:code": "node npm-scripts/deploy.mjs a0febfa5-2ef3-4593-a922-1a1c909e91f3",
    "deploy:infra": "node npm-scripts/deploy-infra.mjs a0febfa5-2ef3-4593-a922-1a1c909e91f3",
    "proof": "node npm-scripts/proof-env.mjs",
    "ticket": "node npm-scripts/ticket-run.mjs",
    "proof:e2e": "node npm-scripts/proof-env.mjs node npm-scripts/e2e-proof.mjs",
    "tenant:apply": "node npm-scripts/tenant-apply.mjs",
    "release:fetch": "node npm-scripts/release-fetch.mjs",
    "guest:image": "node npm-scripts/guest-image.mjs",
    "guest:packages": "node npm-scripts/guest-packages-resolve.mjs",
    "guest:sources": "node npm-scripts/guest-image.mjs sources",
    "harness:layer": "node npm-scripts/harness-layer.mjs",
    "smoke:pi": "node npm-scripts/pi-smoke.mjs",
    "release:publish": "node npm-scripts/release-publish.mjs",
    "release:secrets": "node npm-scripts/release-secrets.mjs",
    "history:split": "node npm-scripts/split/split.mjs",
    "split:sync": "node npm-scripts/split/sync.mjs",
    "release:rc": "node npm-scripts/assemble-rc.mjs",
    "churn": "sh npm-scripts/churn.sh",
    "test:rollout": "node --test --test-timeout=30000 npm-scripts/rollout.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.166.0"
  },
  "license": "Apache-2.0",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  },
  "dependencies": {
    "@tumpel/openapi": "https://github.com/tumpel/protocol/releases/download/v1.0.0-rc.43/tumpel-openapi-1.0.0-rc.43.tgz",
    "@tumpel/schemas": "https://github.com/tumpel/protocol/releases/download/v1.0.0-rc.43/tumpel-schemas-1.0.0-rc.43.tgz",
    "zod": "^4.6.7"
  }
}
