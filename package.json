{
  "name": "tumpel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "build/openapi",
    "build/schemas"
  ],
  "scripts": {
    "prelint": "make generate-ts",
    "lint": "biome check .",
    "fix": "biome check --write . && cargo fmt --all",
    "prebuild": "make generate",
    "build": "npm run build --workspaces --if-present && cargo build --workspace",
    "pretypecheck": "make generate-ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "generate": "make generate",
    "generate:typespec": "make generate-ts",
    "channel:bump": "node typespec/npm-scripts/channel-wire-bump.mjs",
    "channel:drop": "node typespec/npm-scripts/channel-wire-drop.mjs",
    "surface": "node npm-scripts/surface.mjs --write",
    "presurface:check": "make generate-ts",
    "surface:check": "node npm-scripts/surface.mjs",
    "preclippy": "make generate",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "prefmt:check": "make generate",
    "fmt:check": "cargo fmt --all --check",
    "comments:check": "node npm-scripts/comments-check.mjs",
    "secrets:check": "node npm-scripts/secrets-check.mjs",
    "prose:check": "node npm-scripts/prose-check.mjs",
    "preconventions:check": "make generate-ts",
    "conventions:check": "node typespec/npm-scripts/conventions.mjs",
    "precheck": "make generate",
    "check": "npm run check:ts && npm run check:rust",
    "precheck:ts": "make generate-ts",
    "check:ts": "npm run lint && npm run comments:check && npm run secrets:check && npm run prose:check && npm run typecheck && npm run conventions:check && npm run surface:check",
    "precheck:rust": "make generate",
    "check:rust": "npm run clippy && npm run fmt:check",
    "prepare": "git config core.hooksPath .githooks",
    "pretest": "make generate-ts",
    "test": "npm test --workspaces --if-present && node --test --test-timeout=30000 npm-scripts/*.test.mjs",
    "pretest:integration": "make generate",
    "test:integration": "npm run test:integration -w @tumpel/control-plane",
    "predeploy": "make generate",
    "deploy": "node npm-scripts/deploy.mjs",
    "deploy:infra": "node npm-scripts/deploy.mjs infra",
    "predeploy:code": "make generate-ts",
    "deploy:code": "node npm-scripts/deploy.mjs code",
    "deploy:migrate": "node npm-scripts/deploy.mjs migrate",
    "proof": "node npm-scripts/proof-env.mjs",
    "ticket": "node npm-scripts/ticket-run.mjs",
    "proof:e2e": "node npm-scripts/proof-env.mjs node npm-scripts/e2e-proof.mjs",
    "tenant:apply": "node npm-scripts/tenant-apply.mjs",
    "presupervisor:build": "make generate",
    "supervisor:build": "npm run guest:build && npm run guest:drive && TUMPEL_GUEST_DRIVE=\"$PWD/.tmp/guest-drive/${TUMPEL_TARGET:-x86_64-unknown-linux-gnu}.squashfs\" RUSTFLAGS=\"-C target-feature=+crt-static\" cargo build --release -p tumpel-supervisor --target ${TUMPEL_TARGET:-x86_64-unknown-linux-gnu}",
    "supervisor:fetch": "node npm-scripts/supervisor-fetch.mjs",
    "precli:build": "make generate",
    "cli:build": "RUSTFLAGS=\"-C target-feature=+crt-static\" cargo build --release -p tumpel --target ${TUMPEL_TARGET:-x86_64-unknown-linux-gnu}",
    "prerelease:build": "make generate",
    "release:build:cli": "make generate && npm run cli:build",
    "release:build": "npm run guest:build && npm run guest:drive && TUMPEL_GUEST_DRIVE=\"$PWD/.tmp/guest-drive/${TUMPEL_TARGET:-x86_64-unknown-linux-gnu}.squashfs\" RUSTFLAGS=\"-C target-feature=+crt-static\" cargo build --release -p tumpel-supervisor -p tumpel --target ${TUMPEL_TARGET:-x86_64-unknown-linux-gnu}",
    "preguest:build": "make generate",
    "guest:build": "RUSTFLAGS=\"-C target-feature=+crt-static\" cargo build --release -p tumpel-guest --target ${TUMPEL_TARGET:-x86_64-unknown-linux-gnu}",
    "guest:drive": "node npm-scripts/guest-drive.mjs",
    "guest:image": "node npm-scripts/guest-image.mjs",
    "guest:packages": "node npm-scripts/guest-packages-resolve.mjs",
    "harness:layer": "node npm-scripts/harness-layer.mjs",
    "smoke:pi": "node npm-scripts/pi-smoke.mjs",
    "release:publish": "node npm-scripts/release-publish.mjs",
    "release:secrets": "node npm-scripts/release-secrets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
