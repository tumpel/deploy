{
  "name": "tumpel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "fix": "biome check --write . && cargo fmt --all",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "generate": "npm run generate -w @tumpel/api && npm run generate:rust",
    "generate:rust": "cargo run --quiet -p xtask -- generate-api && cargo fmt -p tumpel-api",
    "generate:check": "npm-scripts/generate-check.sh",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "fmt:check": "cargo fmt --all --check",
    "check": "npm run lint && npm run typecheck && npm run clippy && npm run fmt:check && npm run generate:check",
    "prepare": "git config core.hooksPath .githooks",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.0",
    "typescript": "^5.9.0"
  },
  "license": "UNLICENSED"
}
