{
  "pathDenylist": [
    "**/*.tfvars",
    "**/*.tfvars.json",
    "**/*.tfstate",
    "**/.dev.vars",
    "**/.env",
    "**/*.pem",
    "**/*.key"
  ],
  "blobRules": [
    {
      "name": "cloudflare-d1-database-id",
      "pattern": "(?<=\"database_id\"\\s*:\\s*\")[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=\")",
      "detect": "(?<=\"database_id\"\\s*:\\s*\")(?!0{8}-0{4}-0{4}-0{4}-0{12})[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=\")",
      "replacement": "00000000-0000-0000-0000-000000000000"
    },
    {
      "name": "cloudflare-account-or-zone-id",
      "pattern": "(?<=(?:account|zone)(?:_id|Id|_ID|ID)[\"']?\\s*[:=]\\s*[\"']?)[0-9a-f]{32}\\b",
      "detect": "(?<=(?:account|zone)(?:_id|Id|_ID|ID)[\"']?\\s*[:=]\\s*[\"']?)(?!0{32})[0-9a-f]{32}\\b",
      "flags": "i",
      "replacement": "00000000000000000000000000000000"
    },
    {
      "name": "cloudflare-r2-endpoint",
      "pattern": "\\b(?!0{32})[0-9a-f]{32}(?=\\.r2\\.cloudflarestorage\\.com)",
      "replacement": "00000000000000000000000000000000"
    },
    {
      "name": "private-lan-address",
      "pattern": "\\b192\\.168\\.(?!0\\.0\\b|1\\.1\\b)\\d{1,3}\\.\\d{1,3}\\b",
      "replacement": "192.0.2.10"
    },
    {
      "name": "tailnet-address",
      "pattern": "\\b100\\.(?:6[4-9]|[7-9]\\d|1[01]\\d|12[0-7])\\.(?!0\\.[01]\\b)\\d{1,3}\\.\\d{1,3}\\b",
      "replacement": "192.0.2.20"
    },
    {
      "name": "tailnet-hostname",
      "pattern": "\\b(?!example\\b)[a-z0-9-]+(?:\\.[a-z0-9-]+)*\\.ts\\.net\\b",
      "flags": "i",
      "replacement": "example.example.ts.net"
    },
    {
      "name": "private-hostname",
      "pattern": "\\btumpel-host\\b",
      "replacement": "example-host"
    },
    {
      "name": "home-directory",
      "pattern": "/home/mvhenten\\b",
      "replacement": "/home/user"
    },
    {
      "name": "personal-email",
      "pattern": "\\b[A-Za-z0-9._%+-]+@(?:gmail|googlemail|hotmail|outlook|live|icloud|me|protonmail|proton|yahoo|fastmail)\\.(?:com|me|nl|net)\\b",
      "flags": "i",
      "replacement": "someone@example.com"
    },
    {
      "name": "openrouter-key",
      "pattern": "\\bsk-or-v1-(?!0{16}\\b)[0-9a-f]{8,}",
      "replacement": "sk-or-v1-0000000000000000"
    }
  ],
  "messageRules": [
    {
      "name": "pull-request-suffix",
      "pattern": " \\(#\\d+\\)$",
      "flags": "m",
      "replacement": ""
    },
    {
      "name": "issue-trailer",
      "pattern": "^(?:Refs|Closes|Fixes|Resolves|Part of|See)\\b[^\\n]*#\\d+[^\\n]*\\n?",
      "flags": "im",
      "replacement": ""
    },
    {
      "name": "private-issue-url",
      "pattern": "https://github\\.com/mvhenten/tumpel/(?:issues|pull)/\\d+",
      "replacement": "the private tracker"
    }
  ],
  "attributionRules": [
    {
      "name": "claude-co-author",
      "pattern": "^[ \\t]*Co-authored-by:[ \\t]*Claude\\b[^\\n]*<noreply@anthropic\\.com>[ \\t]*(?:\\n|$)",
      "flags": "im",
      "replacement": ""
    },
    {
      "name": "claude-code-generated",
      "pattern": "^[^\\n]*Generated with \\[?Claude Code\\]?(?:\\([^)\\n]*\\))?[^\\n]*(?:\\n|$)",
      "flags": "im",
      "replacement": ""
    },
    {
      "name": "blank-line-runs",
      "pattern": "\\n{3,}",
      "replacement": "\n\n",
      "count": false
    },
    {
      "name": "trailing-blank-lines",
      "pattern": "\\s+$",
      "replacement": "\n",
      "count": false
    }
  ],
  "scanAllowedEmailDomains": [
    "example.com",
    "example.org",
    "example.net",
    "example",
    "test",
    "invalid",
    "users.noreply.github.com",
    "github.com",
    "anthropic.com",
    "claude.ai",
    "tumpel.dev",
    "example.test.evil"
  ]
}
